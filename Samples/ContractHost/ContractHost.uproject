{
  "FileVersion": 3,
  "EngineAssociation": "5.8",
  "Category": "Tests",
  "Description": "SimurghRTC M0 contract host; no RTC transport yet.",
  "DisableEnginePluginsByDefault": true,
  "AdditionalPluginDirectories": [
    "../../Plugins"
  ],
  "Modules": [
    {
      "Name": "ContractHost",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
    {
      "Name": "AndroidPermission",
      "Enabled": true,
      "PlatformAllowList": ["Android"]
    },
    {
      "Name": "SimurghRTC",
      "Enabled": true
    }
  ]
}
