# Linux x86-64 host for M155 Android builds and native host code generators.
FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
ENV DEBIAN_FRONTEND=noninteractive
RUN rm -f /etc/apt/sources.list.d/debian.sources && \
    printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261016T000000Z/ trixie main\n' > /etc/apt/sources.list && \
    printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20261016T000000Z/ trixie-security main\n' >> /etc/apt/sources.list && \
    printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261016T000000Z/ trixie-updates main\n' >> /etc/apt/sources.list && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends python3 python3-pkg-resources git ca-certificates libc6 libstdc++6 zlib1g g++ && \
    dpkg-query -W > /opt/debian-packages.txt && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
ENTRYPOINT ["python3", "tools/build_native_android.py"]
