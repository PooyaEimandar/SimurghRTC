diff --git a/config/android/BUILD.gn b/config/android/BUILD.gn
--- a/config/android/BUILD.gn
+++ b/config/android/BUILD.gn
@@ -46,12 +46,10 @@
     # segments to be mapped adjacently, which breakpad relies on.
     ldflags += [ "-Wl,-z,max-page-size=4096" ]
 
-    # Use non-standard (non-Itanium) ABI for Android64. This shrinks vtables
-    # in half and places them to .rodata, which greatly improves memory
-    # footprint. It should be safe, assuming all of C++ in Chromium is
-    # compiled with this flag.
-    cflags_cc = [ "-fexperimental-relative-c++-abi-vtables" ]
-    ldflags += [ "-fexperimental-relative-c++-abi-vtables" ]
+    # Unreal and its codec/crypto dependencies use the standard Itanium ABI.
+    # Relative vtables are incompatible with virtual calls across that boundary.
+    cflags_cc = [ "-fno-experimental-relative-c++-abi-vtables" ]
+    ldflags += [ "-fno-experimental-relative-c++-abi-vtables" ]
   }
 
   if (current_cpu == "arm64") {
